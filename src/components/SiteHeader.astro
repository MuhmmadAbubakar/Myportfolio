---
import { type Language, languages, translations } from '../data/i18n'
import { projectCopy } from '../data/projects'
import Icon from './Icon.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const t = translations[lang]
const home = (languages.find((item) => item.code === lang) ?? languages[0]).path
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label={`${t.name}: ${t.home}`}>
      <span class="monogram" dir="ltr">am<span>.</span></span>
      <span class="brand-name">{t.name}</span>
    </a>
    <nav class="main-nav" aria-label={t.navigation}>
      <a href={`${home}#about`}>{t.nav.about}</a>
      <a href={`${home}#skills`}>{t.nav.skills}</a>
      <a href={`${home}#projects`}>{projectCopy[lang].nav}</a>
      <a href={`${home}#experience`}>{t.nav.experience}</a>
      <a href={`${home}#testimonials`}>{t.nav.testimonials}</a>
    </nav>
    <div class="header-actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-to-light={t.theme.toLight}
        data-to-dark={t.theme.toDark}
        aria-label={t.theme.toLight}
        aria-pressed="false"
      >
        <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true"><Icon name="moon" /></span>
        <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true"><Icon name="sun" /></span>
      </button>
      <a class="header-contact" href={`${home}#contact`}>{t.nav.contact}<Icon name="arrow" /></a>
    </div>
  </div>
</header>
