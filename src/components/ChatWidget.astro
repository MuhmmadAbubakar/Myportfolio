---
// Floating chatbot (Google Gemini, via /.netlify/functions/chat). Markup only;
// all behaviour lives in /chat-widget.js, loaded from Base.astro, because
// the site's Content-Security-Policy blocks inline scripts. The panel is
// hidden until the toggle opens it. Strings come from translations[lang].chat,
// and the ones the JS needs are passed as data attributes on #chat-widget.
import { type Language, translations } from '../data/i18n'
import Icon from './Icon.astro'

interface Props {
  lang?: Language
}
const { lang = 'en' } = Astro.props
const chat = translations[lang].chat
---
<div
  class="chat-widget"
  id="chat-widget"
  data-fallback={chat.fallback}
  data-session-cap={chat.sessionCap}
  data-rate-limit={chat.rateLimit}
  data-open-label={chat.openLabel}
  data-close-label={chat.closeToggleLabel}
  data-typing-label={chat.typingLabel}
>
  <button
    class="chat-toggle"
    id="chat-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label={chat.openLabel}
  >
    <span class="chat-toggle-icon chat-toggle-open"><Icon name="chat" /></span>
    <span class="chat-toggle-icon chat-toggle-close"><Icon name="x" /></span>
  </button>
  <section
    class="chat-panel"
    id="chat-panel"
    aria-label={chat.panelLabel}
    hidden
  >
    <header class="chat-panel-header">
      <div>
        <p class="chat-panel-title">{chat.title}</p>
        <p class="chat-panel-subtitle">{chat.subtitle}</p>
      </div>
      <button
        class="chat-close"
        id="chat-close"
        type="button"
        aria-label={chat.closeLabel}
      >
        <Icon name="x" />
      </button>
    </header>
    <div class="chat-messages" id="chat-messages" aria-live="polite">
      <div class="chat-message chat-message-assistant">
        <p>{chat.greeting}</p>
      </div>
    </div>
    <form class="chat-form" id="chat-form">
      <label class="sr-only" for="chat-input">{chat.inputLabel}</label>
      <input
        class="chat-input"
        id="chat-input"
        type="text"
        placeholder={chat.inputPlaceholder}
        autocomplete="off"
        maxlength="500"
      />
      <button class="chat-send" id="chat-send" type="submit" aria-label={chat.sendLabel}>
        <Icon name="send" />
      </button>
    </form>
  </section>
</div>
