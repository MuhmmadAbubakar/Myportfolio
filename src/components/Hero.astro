---
import { translations, type Language } from '../data/i18n'
import Icon from './Icon.astro'
interface Props {
  lang: Language
}
const { lang } = Astro.props
const t = translations[lang]
const icons = ['code', 'workflow', 'check'] as const
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="small-dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <p class="greeting">{t.hero.greeting}</p>
    <h1 id="hero-title">{t.hero.lineOne}<br /><span>{t.hero.lineTwo}</span></h1>
    <p class="hero-description">{t.hero.description}</p>
    <div class="actions">
      <a class="button button-primary" href="#projects">{t.hero.primary}<Icon name="down" /></a>
      <a class="text-link" href="#contact">{t.hero.secondary}<Icon name="arrow" /></a>
    </div>
  </div>
  <aside class="workflow" aria-labelledby="workflow-title">
    <div class="workflow-top"><span class="eyebrow">{t.workflow.label}</span><span class="cross" aria-hidden="true">+</span></div>
    <h2 id="workflow-title">{t.workflow.title}</h2>
    <ol class="workflow-steps">
      {t.workflow.steps.map((step, index) => <li>
        <span class="step-icon"><Icon name={icons[index]} /></span>
        <div><h3>{step.title}</h3><p>{step.detail}</p></div>
        <span class="step-number" aria-hidden="true">0{index + 1}</span>
      </li>)}
    </ol>
    <p class="workflow-note"><span class="small-dot" aria-hidden="true"></span>{t.workflow.note}</p>
  </aside>
  <a class="hero-scroll" href="#expertise"><Icon name="down" />{t.hero.scroll}</a>
</section>
<div class="company-strip">
  <p class="eyebrow">{t.companies}</p>
  <ul dir="ltr">
    <li><span class="company-symbol" aria-hidden="true">#</span><span>Hashturn</span></li>
    <li><span class="mortgage-wordmark">o1e<span>Mortgage</span></span></li>
    <li><span class="hl-symbol" aria-hidden="true">HL</span><span>Pro Tools</span></li>
  </ul>
</div>
