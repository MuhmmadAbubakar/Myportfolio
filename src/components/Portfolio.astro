---
import type { Language } from '../data/i18n'
import Base from '../layouts/Base.astro'
import About from './About.astro'
import Certificates from './Certificates.astro'
import Contact from './Contact.astro'
import Education from './Education.astro'
import Experience from './Experience.astro'
import Expertise from './Expertise.astro'
import Hero from './Hero.astro'
import Projects from './Projects.astro'
import Skills from './Skills.astro'
import Testimonials from './Testimonials.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
---
<Base lang={lang}><div class="container"><Hero lang={lang} /><About lang={lang} /><Skills lang={lang} /><Projects lang={lang} /><Expertise lang={lang} /><Experience lang={lang} /><Certificates lang={lang} /><Education lang={lang} /><Testimonials lang={lang} /><Contact lang={lang} /></div></Base>
