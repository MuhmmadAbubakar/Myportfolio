---
import { type Language, translations } from '../data/i18n'
import Icon from './Icon.astro'

interface Props {
  lang: Language
}
const t = translations[Astro.props.lang].skills
const icons = ['code', 'workflow', 'spark', 'game', 'code', 'bag'] as const
/* The two anchor areas get a double-width card in the bento grid. */
const wide = new Set([0, 2])
/* Bento order: the two wide cards render first so they share the top
 * row, then the four singles below. Plain auto-placement cannot do
 * this: in DOM order GoHighLevel (a single) takes the third column of
 * row 1, so AI Agents (wide) no longer fits there and drops to row 2,
 * leaving an empty cell and pushing E-commerce onto a third row.
 * Card numbers follow reading order (01 Web, 02 AI Agents, 03
 * GoHighLevel, 04 Game, 05 Next.js, 06 E-commerce), so they are based
 * on the card's position in the bento, not on the skill's index. */
const order = [0, 2, 1, 3, 4, 5]
const allTags = t.groups.flatMap((group) => group.tags)
---
<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="section-intro">
    <div><p class="eyebrow accent">{t.label}</p><h2 id="skills-title">{t.heading}</h2></div>
    <p>{t.intro}</p>
  </div>
  <div class="skills-grid">
    {order.map((index, position) => { const group = t.groups[index]; return <article class={wide.has(index) ? 'skill-card skill-card--wide' : 'skill-card'}>
      <div class="card-top"><span class="service-icon"><Icon name={icons[index]} /></span><span class="card-index" aria-hidden="true">0{position + 1}</span></div>
      <h3>{group.title}</h3><p>{group.text}</p>
      <ul class="tags">{group.tags.map((tag) => <li>{tag}</li>)}</ul>
    </article>})}
  </div>
  <div class="skills-marquee" aria-hidden="true">
    <div class="skills-marquee-track">
      {[0, 1].map(() => <ul>{allTags.map((tag) => <li>{tag}<span class="skills-marquee-dot">✦</span></li>)}</ul>)}
    </div>
  </div>
</section>
