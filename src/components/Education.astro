---
import { type Language, translations } from '../data/i18n'

interface Props {
  lang: Language
}
const t = translations[Astro.props.lang].education
const marks = ['UCP', 'GSC', 'GMHS']
---
<section class="section education" id="education" aria-labelledby="education-title">
  <div class="section-intro">
    <div><p class="eyebrow accent">{t.label}</p><h2 id="education-title">{t.heading}</h2></div>
    <p>{t.intro}</p>
  </div>
  <div class="education-list">
    {t.items.map((item, index) => <article class="education-row">
      <div class="education-school"><span class="education-mark" aria-hidden="true" dir="ltr">{marks[index]}</span><h3 dir="ltr">{item.school}</h3></div>
      <div class="education-detail"><h4>{item.qualification}<span class="education-dates"> · {item.dates}</span></h4><p>{item.note}</p></div>
      <span class="education-index" aria-hidden="true">0{index + 1}</span>
    </article>)}
  </div>
</section>
