---
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { languages, translations, type Language } from '../data/i18n'
import { site } from '../data/site'
interface Props {
  lang?: Language
  title?: string
  description?: string
  notFound?: boolean
}
const { lang = 'en', title, description, notFound = false } = Astro.props
const t = translations[lang]
const canonical = new URL(Astro.url.pathname, Astro.site)
const locale = languages.find((item) => item.code === lang) ?? languages[0]
---
<!doctype html>
<html lang={lang} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>{title ?? t.title}</title>
    <meta name="description" content={description ?? t.description} />
    <meta name="author" content={site.author} />
    {notFound ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      {languages.map((item) => <link rel="alternate" hreflang={item.code} href={new URL(item.path, Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? t.title} />
    <meta property="og:description" content={description ?? t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.locale} />
    {languages.filter((item) => item.code !== lang).map((item) => <meta property="og:locale:alternate" content={item.locale} />)}
    <meta name="twitter:card" content="summary" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <SiteHeader lang={lang} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter lang={lang} />
  </body>
</html>
