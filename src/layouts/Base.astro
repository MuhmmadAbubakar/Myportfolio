---
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { languages, translations, type Language } from '../data/i18n'
import { site } from '../data/site'
interface Props {
  lang?: Language
  title?: string
  description?: string
  notFound?: boolean
}
const { lang = 'en', title, description, notFound = false } = Astro.props
const t = translations[lang]
const canonical = new URL(Astro.url.pathname, Astro.site)
const locale = languages.find((item) => item.code === lang) ?? languages[0]
---
<!doctype html>
<html lang={lang} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint so the page never flashes
      // the wrong theme. No saved choice means dark, the default.
      try {
        if (localStorage.getItem('portfolio-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light')
        }
      } catch (e) {}
    </script>
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>{title ?? t.title}</title>
    <meta name="description" content={description ?? t.description} />
    <meta name="author" content={site.author} />
    {notFound ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      {languages.map((item) => <link rel="alternate" hreflang={item.code} href={new URL(item.path, Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? t.title} />
    <meta property="og:description" content={description ?? t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.locale} />
    {languages.filter((item) => item.code !== lang).map((item) => <meta property="og:locale:alternate" content={item.locale} />)}
    <meta name="twitter:card" content="summary" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <SiteHeader lang={lang} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter lang={lang} />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const targets = Array.from(
          document.querySelectorAll(
            '.section-intro, .about-heading, .about-copy, .focus, .github-band, ' +
              '.project-card, .expertise-card, .experience-row, ' +
              '.testimonials-summary, .testimonial-card, .testimonials-more, ' +
              '.contact-copy, .contact-actions',
          ),
        )
        // No JS, reduced motion, or no observer: everything stays visible.
        if (!targets.length || reduceMotion || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'))
          return
        }
        document.documentElement.classList.add('js-reveal')
        // Stagger cards inside each grid, capped so the group lands fast.
        for (const selector of ['.projects-grid', '.expertise-grid', '.testimonial-grid', '.experience-list']) {
          const group = document.querySelector(selector)
          if (!group) continue
          Array.from(group.children).forEach((child, index) => {
            child.style.transitionDelay = `${Math.min(index, 4) * 70}ms`
          })
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible')
                observer.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        )
        targets.forEach((el) => observer.observe(el))
        // Cards opened by "See more" start hidden; reveal them on click.
        const toggle = document.querySelector('.testimonials-toggle')
        if (toggle) {
          toggle.addEventListener('click', () => {
            document.querySelectorAll('.testimonial-extra').forEach((card) => card.classList.add('is-visible'))
          })
        }
      })()
    </script>
    <script is:inline>
      // Dark / light theme toggle: saved in localStorage, dark is the default.
      (() => {
        const button = document.querySelector('[data-theme-toggle]')
        if (!button) return
        const root = document.documentElement
        const meta = document.querySelector('meta[name="theme-color"]')
        const sync = (theme) => {
          const light = theme === 'light'
          if (light) root.setAttribute('data-theme', 'light')
          else root.removeAttribute('data-theme')
          button.setAttribute('aria-pressed', String(light))
          button.setAttribute('aria-label', light ? button.dataset.toDark : button.dataset.toLight)
          if (meta) meta.setAttribute('content', light ? '#f5f3ee' : '#0b0b0c')
        }
        // Sync the button with the theme applied before paint (no save).
        sync(root.getAttribute('data-theme') === 'light' ? 'light' : 'dark')
        button.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
          sync(next)
          try {
            localStorage.setItem('portfolio-theme', next)
          } catch (e) {}
        })
      })()
    </script>
  </body>
</html>
